+bool FpsEntry::onProcessMessage(Message* msg)
+{
+  switch (msg->type()) {
+    case kMouseWheelMessage: {
+      if (isEnabled() && !isReadOnly()) {
+        auto mouseMsg = static_cast<MouseMessage*>(msg);
+        int delta = mouseMsg->wheelDelta().x - mouseMsg->wheelDelta().y;
+        if (delta != 0) {
+          WheelDelta(delta);
+          return true;
+        }
+      }
+      break;
+    }
+    case kKeyDownMessage: {
+      KeyMessage* keymsg = static_cast<KeyMessage*>(msg);
+      if (keymsg->scancode() == kKeyEnter || keymsg->scancode() == kKeyEnterPad) {
+        ReturnPressed();
+        releaseFocus();
+        return true;
+      }
+      break;
+    }
+  }
+  return Entry::onProcessMessage(msg);
+}
