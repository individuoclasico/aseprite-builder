+void AniControls::applyFps(int fps)
+{
+  if (fps < 4)
+    fps = 4;
+  int msecs = (int)std::round(1000.0 / double(fps));
+  if (msecs < 1)
+    msecs = 1;
+
+  auto* ctx = UIContext::instance();
+  if (!ctx || !ctx->activeDocument() || !ctx->activeDocument()->sprite())
+    return;
+
+  ContextWriter writer(ctx);
+  Doc* document = writer.document();
+  doc::Sprite* sprite = writer.sprite();
+  if (!document || !sprite)
+    return;
+
+  Tx tx(writer, "Change Frame Rate");
+  DocApi api = document->getApi(tx);
+
+  for (doc::frame_t frame = 0; frame <= sprite->lastFrame(); ++frame) {
+    api.setFrameDuration(sprite, frame, msecs);
+  }
+
+  tx.commit();
+  update_screen_for_document(document);
+}
+
+void AniControls::onDuplicateFrameBefore()
+{
+  auto* ctx = UIContext::instance();
+  if (!ctx || !ctx->activeDocument() || !ctx->activeDocument()->sprite())
+    return;
+
+  ContextWriter writer(ctx);
+  Doc* document = writer.document();
+  doc::Sprite* sprite = writer.sprite();
+  if (!document || !sprite)
+    return;
+
+  Tx tx(writer, "Duplicate Frame Before");
+  DocApi api = document->getApi(tx);
+  doc::frame_t currFrame = writer.frame();
+  api.addEmptyFrame(sprite, currFrame);
+  for (doc::Layer* layer : sprite->allLayers()) {
+    api.copyCel(layer, currFrame + 1, layer, currFrame);
+  }
+  tx.commit();
+
+  update_screen_for_document(document);
+}
+
+void AniControls::onDuplicateFrameAfter()
+{
+  Command* cmd = Commands::instance()->byId(CommandId::NewFrame());
+  if (cmd) {
+    Params params;
+    params.set("content", "frame");
+    UIContext::instance()->executeCommandFromMenuOrShortcut(cmd, params);
+  }
+}
+
+void AniControls::onBlankFrameBefore()
+{
+  auto* ctx = UIContext::instance();
+  if (!ctx || !ctx->activeDocument() || !ctx->activeDocument()->sprite())
+    return;
+
+  ContextWriter writer(ctx);
+  Doc* document = writer.document();
+  doc::Sprite* sprite = writer.sprite();
+  if (!document || !sprite)
+    return;
+
+  Tx tx(writer, "New Empty Frame Before");
+  DocApi api = document->getApi(tx);
+  api.addEmptyFrame(sprite, writer.frame());
+  tx.commit();
+
+  update_screen_for_document(document);
+}
+
